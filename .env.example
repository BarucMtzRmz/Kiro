# LLM backend: "ollama" (fully local) or "openai" (OpenAI-compatible API)
KIRO_LLM_PROVIDER=ollama

# --- Ollama (default, fully local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI-compatible API (OpenAI, LM Studio, vLLM, text-generation-webui, ...) ---
# KIRO_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Retrieval / indexing ---
KIRO_EMBEDDING_MODEL=all-MiniLM-L6-v2
KIRO_CHUNK_SIZE=1000
KIRO_CHUNK_OVERLAP=150
KIRO_TOP_K=4

# --- Storage locations (default to ./data/documents and ./data/index) ---
# KIRO_DATA_DIR=./data/documents
# KIRO_INDEX_DIR=./data/index
